# Neo4j Desktop local DBMS connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=medical

# External data sources
ATC_INDEX_URL=https://atcddd.fhi.no/atc_ddd_index/
