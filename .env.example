# Neo4j Desktop local DBMS connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=medical

# External data sources
ATC_INDEX_URL=https://atcddd.fhi.no/atc_ddd_index/
MESH_XML_URL=https://nlmpubs.nlm.nih.gov/projects/mesh/MESH_FILES/xmlmesh/desc2026.gz
OPENFDA_LABEL_URL=https://api.fda.gov/drug/label.json
DAILYMED_DRUG_URL_TEMPLATE=https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid={set_id}

# Neo4j Browser (for deep links that auto-run a query)
NEO4J_BROWSER_URL=http://localhost:7474/browser/
OPENFDA_EVENT_URL=https://api.fda.gov/drug/event.json
CLINICALTRIALS_API_URL=https://clinicaltrials.gov/api/v2/studies
RXNAV_API_URL=https://rxnav.nlm.nih.gov/REST
ICD10CM_API_URL=https://clinicaltables.nlm.nih.gov/api/icd10cm/v3/search

# Ollama (local LLM + embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
